{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build SoundModem",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/SoundModem.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish SoundModem",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/SoundModem.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "test SoundModem DSP",
            "command": "dotnet",
            "type": "process",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/SoundModem.csproj",
                "--",
                "--self-test"
            ],
            "options": {
                "env": {
                    "DOTNET_ROLL_FORWARD": "Major"
                }
            },
            "problemMatcher": "$msCompile"
        }
    ]
}